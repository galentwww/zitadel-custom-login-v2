# Copy to apps/login/.env.local (git-ignored) and fill in.

# Your ZITADEL instance
ZITADEL_API_URL=https://accounts.xifanacg.com

# PAT of a service user with the "IAM Login Client" role (instance level).
ZITADEL_SERVICE_USER_TOKEN=

# Secret used to sign session cookies (generate: openssl rand -base64 32).
ZITADEL_SESSION_COOKIE_SECRET=

# Keep this unless you also change the Login V2 base URI in ZITADEL.
NEXT_PUBLIC_BASE_PATH=/ui/v2/login

# Optional theme knobs, see .env.theme.example
# NEXT_PUBLIC_THEME_ROUNDNESS=mid
# NEXT_PUBLIC_THEME_LAYOUT=side-by-side
# NEXT_PUBLIC_THEME_APPEARANCE=flat

# Local dev only: the login forwards the browser host (localhost:3000) to the API,
# which ZITADEL rejects (untrusted domain -> 404). Force the real instance host.
# Remove in production when the login is served on a domain ZITADEL trusts.
CUSTOM_REQUEST_HEADERS=x-zitadel-instance-host:accounts.xifanacg.com,x-zitadel-public-host:accounts.xifanacg.com
